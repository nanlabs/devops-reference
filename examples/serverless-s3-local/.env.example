# Deployment Configuration
SERVICE_NAME=serverless-s3-local-example

# S3 Buckets
S3_LAMBDA_TRIGGER_BUCKET_NAME=s3-local-lambda-trigger
S3_EXTRA_BUCKET_NAME=s3-local-extra

# Required by current LocalStack Docker images. Obtain a developer token from
# https://app.localstack.cloud and keep the real value in .env.local only.
LOCALSTACK_AUTH_TOKEN=replace-with-localstack-auth-token
