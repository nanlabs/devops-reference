{
  "name": "nan-appsync-nodejs",
  "version": "1.0.0",
  "description": "Serverless AppSync + TypeScript example",
  "main": "index.js",
  "scripts": {
    "sls": "serverless",
    "sls:deploy": "tsc --rootDir . --outDir .build && serverless deploy",
    "sls:offline": "tsc --rootDir . --outDir .build && node scripts/local-appsync.cjs",
    "sls:package": "tsc --rootDir . --outDir .build && serverless package",
    "test": "tsc --rootDir . --outDir .build && node --test scripts/handler.test.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/nanlabs/devops-reference.git"
  },
  "author": "ulises-jeremias",
  "license": "MIT",
  "homepage": "https://github.com/nanlabs/devops-reference#readme",
  "devDependencies": {
    "@types/aws-lambda": "^8.10.102",
    "graphql": "^16.6.0",
    "serverless": "^4.43.0",
    "typescript": "^5.9.3"
  }
}
